# Go build artifacts
bin/
pkg/
*.test
*.out
coverage.out

# C build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.exe
!Makefile

# Common generated binaries
main
a.out

# Build output
/build/
release/
# Wails desktop build dir: ignore generated output, keep the Linux packaging
# assets (icon hicolor tree + .desktop) which are committed source. The first
# negation overrides a global "build/" ignore so the linux/ subtree is reachable.
!cmd/desktop/build/
cmd/desktop/build/*
!cmd/desktop/build/linux/

# Wails embed placeholder (real dist is built by wails build)
cmd/desktop/frontend/
